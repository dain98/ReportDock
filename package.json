{
  "name": "reportdock-workspace",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev:server": "npm run dev -w @reportdock/server",
    "start": "npm run start -w @reportdock/server"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
